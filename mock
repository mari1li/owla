<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Merge Assist Mock</title>
<style>
body{font:15px system-ui;background:#111;color:#eee;padding:20px}
#road{position:relative;width:360px;height:300px;background:#2a2a2e;border-radius:10px;overflow:hidden}
.car{position:absolute;width:40px;height:70px;border-radius:6px}
#alert{padding:12px;border-radius:6px;background:#1c1c20;margin:12px 0;width:336px;font-weight:600}
button,select{padding:8px 14px;margin:2px;background:#2a2a30;color:#eee;border:1px solid #444;border-radius:5px}
pre{color:#9a9;font-size:12px}
</style></head><body>

<div id="alert">Monitoring</div>
<div id="road"><div class="car" id="me" style="background:#3a7;left:160px;top:210px"></div></div>
<p>
<button onclick="add()">Car on right</button>
<button onclick="exitMi=1.2">Exit ahead</button>
<select id="prof"><option value=8>Very new 8s</option><option value=6 selected>New 6s</option><option value=4>Experienced 4s</option></select>
</p>
<pre id="log"></pre>

<script>
let cars=[], exitMi=null, spoke=0;

function add(){
  let e=document.createElement('div');
  e.className='car'; e.style.background='#a44';
  road.appendChild(e);
  cars.push({e, d:80, v:5+Math.random()*8});
}

function say(t){
  if(Date.now()-spoke<4000) return;
  speechSynthesis.speak(new SpeechSynthesisUtterance(t));
  spoke=Date.now();
}

setInterval(()=>{
  let lim=+prof.value, msg='', cls='#1c1c20', out=[];

  cars=cars.filter(c=>{
    c.d-=c.v*0.25;
    if(c.d<-10){ c.e.remove(); return false; }
    c.e.style.left='290px';
    c.e.style.top=(210-(80-c.d)*-1.6)+'px';
    let tta=c.d/c.v;
    out.push(`right: ${c.d.toFixed(0)}m  closing ${c.v.toFixed(1)}m/s  TTA ${tta.toFixed(1)}s`);
    if(c.d>0 && tta<lim){ msg=`Vehicle closing on your right, ${tta.toFixed(1)} seconds`; cls='#5a2a00'; }
    return true;
  });

  if(exitMi!==null){
    exitMi-=0.012;
    if(exitMi<=0) exitMi=null;
    else{
      out.push(`exit in ${exitMi.toFixed(2)} mi`);
      if(!msg && exitMi<0.8){ msg=`Exit in ${exitMi.toFixed(1)} miles, move right when clear`; cls='#0d3a4a'; }
    }
  }

  alert.textContent = msg ? msg+'  ·  check your mirror' : 'Monitoring';
  alert.style.background = cls;
  if(msg) say(msg);
  log.textContent = `margin ${lim}s\n` + (out.join('\n')||'nothing detected');
},250);
</script></body></html>
